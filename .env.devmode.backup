# Minimal local-dev .env — generated to bring the stack up for verification.
# Replace with real secrets for production use.

# Cassandra
CASSANDRA_USERNAME=sesamefs
CASSANDRA_PASSWORD=sesamefs-dev-pw
CASSANDRA_SUPERUSER_PASSWORD=cassandra

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Frontend host port (3000 taken on this machine)
FRONTEND_HOST_PORT=5173

# Sesamefs host port (8080 taken on this machine)
SESAMEFS_HOST_PORT=8090

# Server / auth
SERVER_URL=http://localhost:5173
FIRST_SUPERADMIN_EMAIL=admin@sesamefs.local
AUTH_DEV_MODE=true

# OIDC (disabled for local dev — provide empty values to satisfy compose)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URIS=
OIDC_JWT_SIGNING_KEY=
OIDC_ROLES_CLAIM=
OIDC_ORG_CLAIM=
OIDC_DEFAULT_ORG_ID=
OIDC_PLATFORM_ORG_ID=
OIDC_PLATFORM_ORG_CLAIM_VALUE=
