# =============================================================================
# SesameFS — Development Environment
# =============================================================================
# Usage:
#   cp .env.example .env
#   docker compose up --build
#
# All defaults work out of the box for local dev — no changes needed.
# For production deployment use .env.prod.example instead.
#
# To run this stack as "prod-like" on a staging server (OIDC real, no dev mode)
# see the "Staging / test server" notes inline below.
# =============================================================================


# =============================================================================
# SesameFS API Server
# =============================================================================

# Internal port inside the container
PORT=8080

# Host port exposed on your machine → http://localhost:3000
SESAMEFS_HOST_PORT=3000

# Public URL used for generating download/upload links.
# Leave commented to derive from the incoming request Host header —
# allows the same container to serve multiple hostnames.
# Staging: set to the public HTTPS URL, e.g. https://test.yourdomain.com
# SERVER_URL=http://localhost:3000

# Comma-separated list of reverse proxy CIDRs/IPs allowed to set X-Forwarded-*.
# Leave empty in local dev. Required in staging behind nginx — inspect the
# Docker subnet with: docker network inspect <net> --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# SERVER_TRUSTED_PROXIES=172.20.0.0/16

# Optional process-local anonymous public-link write guards. Stable source keys
# survive seafhttp token remints; aggregate fleet capacity scales with nodes.
# SEAFHTTP_UPLOAD_LINK_WRITES_PER_MINUTE=600
# SEAFHTTP_UPLOAD_LINK_WRITE_BURST=1200
# SEAFHTTP_UPLOAD_LINK_SOURCE_WRITES_PER_MINUTE=12000
# SEAFHTTP_UPLOAD_LINK_SOURCE_WRITE_BURST=24000
# SEAFHTTP_UPLOAD_LINK_MAX_INFLIGHT_PER_SOURCE=16
# SEAFHTTP_UPLOAD_LINK_MAX_INFLIGHT_PER_NODE=128
# Aggregate bound on concurrent desktop-sync block uploads (subcontract B / X10).
# The node cap is a memory budget divided by a measured per-request cost, not a
# throughput setting; re-derive it if you change SEAFHTTP_SYNC_BLOCK_MAX_BYTES.
# Over-cap requests wait, then get 503 + Retry-After (never 429).
# SEAFHTTP_SYNC_BLOCK_MAX_INFLIGHT_PER_NODE=24
# SEAFHTTP_SYNC_BLOCK_MEMORY_BUDGET_BYTES=2147483648
# SEAFHTTP_SYNC_BLOCK_MAX_INFLIGHT_PER_USER=16
# SEAFHTTP_SYNC_BLOCK_ADMISSION_WAIT=10s
# SEAFHTTP_SYNC_BLOCK_MAX_WAITERS_PER_USER=16
# SEAFHTTP_SYNC_BLOCK_MAX_WAITERS_PER_NODE=128
# SEAFHTTP_SYNC_BLOCK_ADMITTED_LIFETIME=5m
# Bound on check-blocks admission and per-request metadata work (subcontract C /
# X11). The node cap and the fan-out multiply: node x fanout is the number of
# concurrent Cassandra/object-store lookups this route may issue. Over-cap
# requests wait, then get 503 + Retry-After (never 429).
# SEAFHTTP_CHECK_BLOCKS_MAX_INFLIGHT_PER_NODE=8
# SEAFHTTP_CHECK_BLOCKS_MAX_INFLIGHT_PER_USER=4
# SEAFHTTP_CHECK_BLOCKS_MAX_WAITERS_PER_NODE=64
# SEAFHTTP_CHECK_BLOCKS_MAX_WAITERS_PER_USER=8
# SEAFHTTP_CHECK_BLOCKS_ADMISSION_WAIT=10s
# SEAFHTTP_CHECK_BLOCKS_ADMITTED_LIFETIME=5m
# SEAFHTTP_CHECK_BLOCKS_LOOKUP_FANOUT=8
# Accepted ids per request. 100000 is both the shipped default and the ceiling:
# lower it from sync_check_blocks_ids_per_request, never raise it.
# SEAFHTTP_CHECK_BLOCKS_MAX_IDS=100000

# Download admission. Auto mode derives node/profile capacities from 25% of the
# cgroup limit, with a 20% safety margin. The 2 GiB fallback derives 4 raw + 12
# stream slots (16 active admissions) per process. Validation ceilings
# are 1024 active per node/identity or profile, 4096 node waiters, 1024 identity waiters, 5m admission wait, 1h
# preparation, 15m idle-write and 1h Retry-After.
# DOWNLOAD_ADMISSION_ENABLED=true
# DOWNLOAD_ADMISSION_CAPACITY_MODE=auto       # manual requires explicit caps
# DOWNLOAD_ADMISSION_MEMORY_BUDGET_PERCENT=25
# DOWNLOAD_ADMISSION_RAW_CAPACITY_PERCENT=33
# DOWNLOAD_ADMISSION_SAFETY_MARGIN_PERCENT=20
# Explicit override. Leave it unset for the normal path: auto mode derives the
# budget from the container limit, or falls back to 2 GiB when none is exposed.
# Setting it switches that derivation off.
# DOWNLOAD_ADMISSION_MEMORY_BUDGET_BYTES=2147483648
# DOWNLOAD_ADMISSION_MAX_ACTIVE_PER_NODE=16             # manual mode only
# DOWNLOAD_ADMISSION_MAX_ACTIVE_PER_AUTH_USER=6         # manual mode only
# DOWNLOAD_ADMISSION_MAX_ACTIVE_PER_LINK_SOURCE=6       # manual mode only
# DOWNLOAD_ADMISSION_MAX_ACTIVE_PER_CLIENT_LINK=3       # manual mode only
# DOWNLOAD_ADMISSION_MAX_WAITERS_PER_IDENTITY=4
# DOWNLOAD_ADMISSION_MAX_WAITERS_PER_NODE=24
# DOWNLOAD_ADMISSION_ADMISSION_WAIT=2s
# DOWNLOAD_ADMISSION_PREPARATION_DEADLINE=60s
# DOWNLOAD_ADMISSION_IDLE_WRITE_TIMEOUT=60s
# DOWNLOAD_ADMISSION_RETRY_AFTER=10s
# DOWNLOAD_ADMISSION_MAX_ACTIVE_BLOCK=12
# DOWNLOAD_ADMISSION_MAX_ACTIVE_FILE=12
# DOWNLOAD_ADMISSION_MAX_ACTIVE_RAW=4
# DOWNLOAD_ADMISSION_MAX_ACTIVE_HISTORY=6
# DOWNLOAD_ADMISSION_MAX_ACTIVE_LINK_RAW=12
# DOWNLOAD_ADMISSION_MAX_ACTIVE_ZIP=4
# DOWNLOAD_ADMISSION_MAX_ACTIVE_LINK_INLINE=8


# =============================================================================
# CORS — allowed origins
# =============================================================================
# Comma-separated list of origins allowed to make cross-origin requests.
# AUTH_DEV_MODE=true: optional, defaults in configs/config.docker.yaml are fine.
# AUTH_DEV_MODE=false: REQUIRED. Wildcard "*" is rejected. Must be HTTPS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000


# =============================================================================
# Authentication — dev mode uses static tokens, no OIDC needed
# =============================================================================

# When true, dev tokens (dev-token-*) work and SHARE_LINK_HMAC_KEY accepts any value.
# Set to false for staging/prod-like testing → forces OIDC and real secrets.
AUTH_DEV_MODE=true

# Dev tokens are defined in configs/config.docker.yaml:
#   dev-token-superadmin  → superadmin role
#   dev-token-admin       → admin role
#   dev-token-user        → user role
#   dev-token-readonly    → readonly role
#   dev-token-guest       → guest role
#
# Usage: curl -H "Authorization: Token dev-token-admin" http://localhost:3000/api2/repos/


# =============================================================================
# First superadmin (only used when AUTH_DEV_MODE=false)
# =============================================================================
# Email of the initial superadmin. On first startup SesameFS seeds the DB with
# a superadmin account in the platform org using this email. When you log in via
# OIDC with this address you enter as superadmin. Seed runs ONCE — after the
# first deploy this value is ignored.
# FIRST_SUPERADMIN_EMAIL=you@yourdomain.com


# =============================================================================
# OIDC — disabled in dev by default
# =============================================================================
# Uncomment and fill in to test OIDC locally or on a staging server against a
# real provider (e.g. accounts.sesamedisk.com).
#
# OIDC_REDIRECT_URIS must be HTTPS when pointing at accounts.sesamedisk.com
# (use Cloudflare Tunnel / ngrok / nginx+certbot in front of the stack).

# OIDC_ENABLED=true
# OIDC_ISSUER=https://accounts.sesamedisk.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URIS=http://localhost:3000/sso,http://localhost:3000/oauth/callback/

# Session signing key — generate with: openssl rand -hex 32
# NEVER change after first login (invalidates all active sessions)
# OIDC_JWT_SIGNING_KEY=

# Token lifetimes
# OIDC_SESSION_TTL=24h               # Web browser sessions
# OIDC_API_TOKEN_TTL=4320h           # Desktop/mobile sync client tokens (180 days)

# PKCE — recommended ON (matches the client registered in Accounts)
# OIDC_REQUIRE_PKCE=true

# Auto-provision users that don't exist yet at first login.
# Disabled by default — users must be pre-created / synced from Accounts.
# OIDC_AUTO_PROVISION=false
# OIDC_DEFAULT_ROLE=user

# Claim mapping — leave unset unless your OIDC provider uses custom claims
# for roles / org membership.
# OIDC_ROLES_CLAIM=
# OIDC_ORG_CLAIM=
# OIDC_DEFAULT_ORG_ID=
# OIDC_PLATFORM_ORG_ID=
# OIDC_PLATFORM_ORG_CLAIM_VALUE=


# =============================================================================
# Cassandra
# =============================================================================

CASSANDRA_HOSTS=cassandra:9042
CASSANDRA_KEYSPACE=sesamefs
CASSANDRA_LOCAL_DC=datacenter1
# Default non-serial query consistency for app reads/writes.
# Keep LOCAL_QUORUM unless you are deliberately changing the runtime contract.
CASSANDRA_CONSISTENCY=LOCAL_QUORUM
# Serial phase consistency for LWT / CAS queries.
# Keep SERIAL in multiregion so conditional updates serialize across DCs.
CASSANDRA_SERIAL_CONSISTENCY=SERIAL
# Optional local override. Leave unset to use configs/config.docker.yaml (10s).
# CASSANDRA_TIMEOUT=10s
CASSANDRA_CLUSTER_NAME=sesamefs
CASSANDRA_DC=datacenter1
CASSANDRA_MAX_HEAP_SIZE=512M
CASSANDRA_HEAP_NEWSIZE=100M

# Dev now boots Cassandra with PasswordAuthenticator too, so the local stack can
# exercise the same database-auth path as prod before commit.
CASSANDRA_SUPERUSER_PASSWORD=dev-cassandra-admin
CASSANDRA_USERNAME=sesamefs_app
CASSANDRA_PASSWORD=dev-sesamefs-db-pass
CASSANDRA_REPLICATION_CLASS=NetworkTopologyStrategy
CASSANDRA_REPLICATION_DCS=datacenter1:1
# CASSANDRA_REPLICATION_FACTOR is only used with legacy SimpleStrategy.
# It is ignored in the default NetworkTopologyStrategy path above.

# Exposed on host for direct access with cqlsh or DB tools.
# Staging: remove or firewall-restrict if the server is internet-facing.
CASSANDRA_HOST_PORT=9042


# =============================================================================
# S3 — uses local MinIO in dev (S3-compatible, no AWS account needed)
# =============================================================================

S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=sesamefs-blocks
S3_ENDPOINT=http://minio:9000

# MinIO console → http://localhost:9001 (login: minioadmin / minioadmin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001


# =============================================================================
# Share Link Security
# =============================================================================
# HMAC key used to sign password-unlock cookies for password-protected share
# and upload links. Keeps the user authenticated to the share link for 24 hours
# so they don't have to re-enter the password on every page.
#
# AUTH_DEV_MODE=false: this MUST be a securely generated secret (openssl rand -hex 32).
# SesameFS REFUSES to start if missing or set to the insecure default.
# AUTH_DEV_MODE=true:  any value is accepted.
SHARE_LINK_HMAC_KEY=dev-share-link-hmac-key


# =============================================================================
# OnlyOffice Document Server
# =============================================================================

ONLYOFFICE_ENABLED=true
ONLYOFFICE_HOST_PORT=8088

# API JS URL seen by the browser. Default works for localhost dev.
# Staging: set to https://<office-subdomain>/web-apps/apps/api/documents/api.js
# ONLYOFFICE_API_JS_URL=http://localhost:8088/web-apps/apps/api/documents/api.js

# Shared JWT secret — generate with: openssl rand -hex 32
# AUTH_DEV_MODE=false requires a real secret here too.
ONLYOFFICE_JWT_SECRET=dev-only-jwt-secret


# =============================================================================
# External redirect targets (Accounts portal)
# =============================================================================
# SesameFS redirects to these URLs for billing / password change / account
# delete / org user management. Leave commented for local dev — links are
# hidden or disabled when empty.
# BILLING_URL=https://t-accounts.sesamedisk.com/billing/
# ACCOUNTS_DELETE_ACCOUNT_URL=https://t-accounts.sesamedisk.com/accounts/delete/

# Org user management link in org-admin panel. {org_id} is replaced at runtime.
# ACCOUNTS_ORG_USER_MANAGEMENT_URL=https://t-accounts.sesamedisk.com/orgs/{org_id}/members/

# When true, org-admin cannot create/edit/delete users in SesameFS directly —
# writes are delegated to Accounts. Set true when using Accounts integration.
# ACCOUNTS_DISABLE_ORG_USER_WRITES=false


# =============================================================================
# Frontend
# =============================================================================

# Host port for the React SPA container → http://localhost:3000
FRONTEND_HOST_PORT=3000

# Empty = relative URLs — API and frontend on same origin (recommended).
# Only set if frontend and backend run on different hosts.
SESAMEFS_API_URL=

# Internal URL of the frontend container. The backend uses this to fetch
# asset-manifest.json at startup so share link pages can load hashed JS/CSS
# bundles. Default is correct for docker-compose — only change if the frontend
# container runs on a different host or port.
# FRONTEND_URL=http://frontend:80


# =============================================================================
# Mobile frontend
# =============================================================================

MOBILE_FRONTEND_HOST_PORT=5173

# URL the mobile PWA uses to reach the API. For docker-compose leave as-is.
# API_URL=http://sesamefs:8080


# =============================================================================
# Seafile CLI — sync protocol testing  [optional, needs --profile debug]
# =============================================================================
# docker compose --profile debug up seafile-cli

SEAF_CLI_SERVER_URL=http://sesamefs:8080
SEAF_CLI_USERNAME=00000000-0000-0000-0000-000000000001
SEAF_CLI_PASSWORD=dev-token-user

# Protocol capture against a real Seafile server  [optional]
# SEAF_DEBUG_SERVER_URL=https://your-seafile-server.com
# SEAF_DEBUG_USERNAME=your-email@example.com
# SEAF_DEBUG_PASSWORD=your-password


# =============================================================================
# File Preview Limits  [optional — defaults in configs/config.docker.yaml are fine]
# =============================================================================
# FILEVIEW_MAX_PREVIEW_BYTES=1073741824    # 1 GB
# FILEVIEW_MAX_VIDEO_BYTES=10737418240     # 10 GB
# FILEVIEW_MAX_TEXT_BYTES=52428800         # 50 MB
# FILEVIEW_MAX_IWORK_PREVIEW_BYTES=52428800 # 50 MB
# FILEVIEW_MAX_IWORK_SOURCE_BYTES=33554432  # 32 MiB; required when download admission is enabled
