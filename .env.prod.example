# =============================================================================
# SesameFS — Production Environment
# =============================================================================
# Usage:
#   cp .env.prod.example .env
#   nano .env    ← fill in every <...> value
# Then deploy:
#   docker compose -f docker-compose.prod.yml up -d
#
# See docs/DEPLOY.md for the full step-by-step guide.

# This same file supports both production modes:
#   - single-region: leave SERVER_REGION empty and fill the S3_* values below
#   - multi-region: set SERVER_REGION and keep bucket/region topology in
#     configs/config.prod.yaml storage.classes

# Bucket names, regions, failover chains and storage tiers now live in
# configs/config.prod.yaml as shared structural config. This .env only carries
# secrets and node-local metadata such as SERVER_REGION.


# =============================================================================
# Public URL fallback (optional)
# =============================================================================

# Leave SERVER_URL unset in the standard deploy. SesameFS will derive the public
# host from the current request / X-Forwarded-Host, which is what you want when
# the same deploy serves multiple domains.
#
# Set SERVER_URL only if you need an explicit fallback for unusual proxy paths or
# absolute-link generation when the request does not carry usable host context.
# SERVER_URL=https://files.sesamedisk.com


# =============================================================================
# S3 Object Storage Credentials
# =============================================================================

# Default credential pair used by any storage class that does not define its own
# S3_CLASS_<CLASS>_ACCESS_KEY_ID / SECRET_ACCESS_KEY values.
S3_ACCESS_KEY_ID=<your-s3-access-key-id>
S3_SECRET_ACCESS_KEY=<your-s3-secret-access-key>

# Single-region legacy path:
#   leave SERVER_REGION empty and set these to your single production bucket.
# Multi-region shared config path:
#   leave these commented out and define buckets/regions in configs/config.prod.yaml.
# S3_BUCKET=<your-bucket-name>
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_SSE_KMS_KEY_ID=


# =============================================================================
# Cassandra
# =============================================================================

CASSANDRA_CLUSTER_NAME=sesamefs-prod
CASSANDRA_MAX_HEAP_SIZE=2G
CASSANDRA_HEAP_NEWSIZE=400M

# Keyspace name (default: sesamefs). Change if you run multiple stacks against
# the same cluster — each stack needs its own keyspace.
# CASSANDRA_KEYSPACE=sesamefs

# Credentials — only if Cassandra auth is enabled
# CASSANDRA_USERNAME=cassandra
# CASSANDRA_PASSWORD=<strong-password>


# =============================================================================
# Multi-Region (optional)
# =============================================================================
# This deploy stays the same in every region. Only `.env` changes per server.
# For multi-region, set the regional values below on each server.
# See docs/DEPLOY.md § Multi-Region for the full guide.
# =============================================================================

# Explicit storage mode.
#   multi  -> default production mode; requires SERVER_REGION and shared topology in config.prod.yaml
#   single -> legacy single-bucket mode; requires S3_BUCKET/S3_REGION
STORAGE_MODE=multi

# Multi-region storage classes keep their public topology in config.prod.yaml, but
# real bucket names and optional per-class credentials stay in .env.
#
# Required in STORAGE_MODE=multi:
S3_CLASS_HOT_S3_NA_BUCKET=<your-na-bucket>
S3_CLASS_HOT_S3_EU_BUCKET=<your-eu-bucket>
S3_CLASS_HOT_S3_ASIA_BUCKET=<your-asia-bucket>
#
# Optional per-class credential overrides. If omitted, SesameFS falls back to the
# default S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY above.
# S3_CLASS_HOT_S3_NA_ACCESS_KEY_ID=<optional-class-specific-key>
# S3_CLASS_HOT_S3_NA_SECRET_ACCESS_KEY=<optional-class-specific-secret>
# S3_CLASS_HOT_S3_EU_ACCESS_KEY_ID=<optional-class-specific-key>
# S3_CLASS_HOT_S3_EU_SECRET_ACCESS_KEY=<optional-class-specific-secret>
# S3_CLASS_HOT_S3_ASIA_ACCESS_KEY_ID=<optional-class-specific-key>
# S3_CLASS_HOT_S3_ASIA_SECRET_ACCESS_KEY=<optional-class-specific-secret>

# Region identifier for this server (e.g. na, eu, asia).
# Leave empty for single-region. Set on each node when STORAGE_MODE=multi.
# SERVER_REGION=na

# Cassandra hosts — how SesameFS connects to Cassandra
# Default: cassandra:9042 (Docker service name — works for both single and multi-region)
# Do NOT change this for multi-region. SesameFS talks to its LOCAL Cassandra via Docker.
# Cross-DC replication is handled by Cassandra itself (via SEEDS/BROADCAST_ADDRESS).
# CASSANDRA_HOSTS=cassandra:9042

# Cassandra datacenter and rack for this node
# CASSANDRA_DC=dc-na
# CASSANDRA_LOCAL_DC=dc-na
# CASSANDRA_RACK=rack1

# Cassandra seed nodes — private IPs, comma-separated (2 seeds per DC recommended)
# CASSANDRA_SEEDS=10.0.1.10,10.0.2.20,10.0.3.30

# Private/vRack IP of THIS server — used for Cassandra inter-node communication
# CASSANDRA_BIND_IP: host IP where Docker exposes gossip/CQL ports
# CASSANDRA_BROADCAST_ADDRESS: host private IP announced to other Cassandra nodes
# CASSANDRA_RPC_ADDRESS: 0.0.0.0 allows CQL from all interfaces inside the container
# CASSANDRA_BROADCAST_RPC_ADDRESS: host private IP for CQL client connections
# NOTE: Do NOT set CASSANDRA_LISTEN_ADDRESS — Cassandra auto-detects the container IP.
#       Docker port mapping routes traffic from the host private IP to the container.
# CASSANDRA_BIND_IP=10.0.1.10
# CASSANDRA_RPC_ADDRESS=0.0.0.0
# CASSANDRA_BROADCAST_ADDRESS=10.0.1.10
# CASSANDRA_BROADCAST_RPC_ADDRESS=10.0.1.10

# Reverse proxy CIDRs or IPs allowed to define the real client IP via
# X-Forwarded-For / X-Real-IP. Comma-separated. Leave unset to disable trust.
# Supported prod topology here is:
#   client -> central nginx -> internal SesameFS nginx -> Go
# The internal nginx, typically the nginx inside the frontend container,
# preserves the client IP already resolved by the central nginx, so Go only
# needs to trust that internal nginx network.
# This assumes that internal nginx is private and not directly reachable from
# arbitrary external callers.
# For the internal SesameFS nginx on Docker, inspect the real subnet first:
#   docker network inspect sfs-net --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Example:
# SERVER_TRUSTED_PROXIES=172.20.0.0/16


# =============================================================================
# CORS — Allowed Origins
# =============================================================================
# Comma-separated list of origins allowed to make cross-origin requests.
# This must include EVERY production browser origin that can call SesameFS with
# cookies or auth headers. Add all public app domains here.
# Wildcard "*" is rejected in production mode.
# Example: CORS_ALLOWED_ORIGINS=https://files.sesamedisk.com,https://files-alt.sesamedisk.com,https://app.sesamedisk.com
CORS_ALLOWED_ORIGINS=https://files.sesamedisk.com


# =============================================================================
# GC Operational Guard (temporary)
# =============================================================================
# Until distributed GC leadership exists, exactly ONE backend replica must run GC.
# Set GC_ENABLED=true only on the designated GC node. Set GC_ENABLED=false on all
# other replicas. Single-node deployments can leave this as true.
GC_ENABLED=false

# GC retention tuning (days) — override the built-in defaults.
# Leave commented to keep code defaults (7/30/30/90).
# Useful in staging to test soft-delete cascades without waiting days.
# GC_USER_GRACE_DAYS=7
# GC_ORG_GRACE_DAYS=30
# GC_TRASH_RETENTION_DAYS=30
# GC_AUDIT_RETENTION_DAYS=90


# =============================================================================
# Monitoring
# =============================================================================
# Prometheus metrics endpoint. METRICS_ENABLED is forced to true by compose.
# METRICS_PATH=/metrics
# HEALTH_TIMEOUT=5s


# =============================================================================
# First superadmin
# =============================================================================
# Email of the initial superadmin. On first startup, SesameFS seeds the DB with
# a superadmin account in the platform org using this email. When you log in via
# OIDC with this address, you enter as superadmin and can manage organizations.
# After the first deploy this value is ignored (seed only runs once).
FIRST_SUPERADMIN_EMAIL=<your-email@yourdomain.com>

# =============================================================================
# OIDC (accounts.sesamedisk.com)
# =============================================================================
# Register every production login callback in your IdP, then list them all here.
# You can include multiple domains in the same deploy.
# Example:
# OIDC_REDIRECT_URIS=https://files.sesamedisk.com/sso/,https://files.sesamedisk.com/oauth/callback/,https://files-alt.sesamedisk.com/sso/,https://files-alt.sesamedisk.com/oauth/callback/

OIDC_ISSUER=<your-oidc-issuer-url, e.g. https://auth.example.com/openid>
OIDC_CLIENT_ID=<your-oidc-client-id>
OIDC_CLIENT_SECRET=<your-oidc-client-secret>
OIDC_REDIRECT_URIS=https://files.sesamedisk.com/sso/,https://files.sesamedisk.com/oauth/callback/

# Session signing key — generate with: openssl rand -hex 32
# NEVER change after deploy (invalidates all active sessions)
OIDC_JWT_SIGNING_KEY=<run: openssl rand -hex 32>

# --- OIDC security policy ---
# PKCE — must match the client registered in Accounts
OIDC_REQUIRE_PKCE=true
# Validate that `aud` claim matches OIDC_CLIENT_ID
OIDC_VALIDATE_AUDIENCE=true
# Allowed clock skew when validating token timestamps
# OIDC_ALLOWED_CLOCK_SKEW=30s

# --- OIDC lifetimes ---
# OIDC_SESSION_TTL=24h               # Web browser sessions
# OIDC_API_TOKEN_TTL=4320h           # Desktop/mobile sync client tokens (180 days)
# OIDC_REFRESH_TOKEN_TTL=720h        # Refresh token lifetime (30 days)

# --- OIDC provisioning ---
# Auto-create user accounts on first login when they don't exist yet.
# Leave false when users are pre-provisioned via Accounts sync.
OIDC_AUTO_PROVISION=false
# Role assigned to auto-provisioned users (ignored if AUTO_PROVISION=false)
# OIDC_DEFAULT_ROLE=user

# --- OIDC multi-tenant claim mapping ---
# Required when Accounts sends multiple orgs via claims. Without these, every
# user lands in the default org.
#
# OIDC_ORG_CLAIM       : claim name in ID token that contains the org identifier
# OIDC_ROLES_CLAIM     : claim name that contains role strings (superadmin/admin/user/...)
# OIDC_DEFAULT_ORG_ID  : fallback org for users whose token has no org claim
# OIDC_DEFAULT_ORG_NAME: display name for the default org (used on first-user setup)
# OIDC_ALLOWED_ORG_CLAIMS: comma-separated whitelist of org-claim values (optional)
# OIDC_ORG_CLAIM=organization_id
# OIDC_ROLES_CLAIM=roles
# OIDC_DEFAULT_ORG_ID=
# OIDC_DEFAULT_ORG_NAME=
# OIDC_ALLOWED_ORG_CLAIMS=

# --- OIDC platform org (superadmin seed) ---
# The "platform org" is where the FIRST_SUPERADMIN_EMAIL account is seeded.
# If Accounts identifies the platform org with a specific claim value, set
# both vars so SesameFS routes superadmins to the correct org on login.
# OIDC_PLATFORM_ORG_ID=
# OIDC_PLATFORM_ORG_CLAIM_VALUE=

# --- OIDC group / department sync (optional) ---
# OIDC_GROUPS_CLAIM=groups
# OIDC_DEPARTMENTS_CLAIM=departments
# OIDC_SYNC_GROUPS_ON_LOGIN=false
# OIDC_SYNC_DEPARTMENTS_ON_LOGIN=false
# OIDC_FULL_SYNC_GROUPS=false
# OIDC_FULL_SYNC_DEPARTMENTS=false


# =============================================================================
# Share Link Security
# =============================================================================
# HMAC key used to sign password-unlock cookies for password-protected share
# and upload links. Without this, users would have to re-enter the share link
# password on every page load instead of being remembered for 24 hours.
#
# Generate with: openssl rand -hex 32
# NEVER use the default value in production — sesamefs refuses to start if
# this key is missing or set to the insecure default.
SHARE_LINK_HMAC_KEY=<run: openssl rand -hex 32>


# =============================================================================
# External Redirect Targets (Accounts portal)
# =============================================================================

# Billing portal — SesameFS /billing/ redirects here
BILLING_URL=https://accounts.yourdomain.com/billing/

# Account deletion — SesameFS /accounts/delete/ redirects here
ACCOUNTS_DELETE_ACCOUNT_URL=https://accounts.yourdomain.com/accounts/delete/

# Org user management URL — shown in org-admin panel as "Manage users in Accounts".
# The {org_id} placeholder is replaced with the real org UUID at runtime.
# Leave empty to hide the "Manage in Accounts" button from org-admin.
ACCOUNTS_ORG_USER_MANAGEMENT_URL=https://accounts.yourdomain.com/orgs/{org_id}/members/

# When true, org-admin can NOT create/edit/delete users directly in SesameFS —
# user writes are delegated entirely to Accounts. Set true when Accounts is the
# source of truth for org membership (standard SesameFS SaaS setup).
# Set false only for standalone deployments without Accounts integration.
ACCOUNTS_DISABLE_ORG_USER_WRITES=true


# =============================================================================
# OnlyOffice
# =============================================================================

# Public JS loader URL served by OnlyOffice.
ONLYOFFICE_API_JS_URL=https://office.yourdomain.com/web-apps/apps/api/documents/api.js

# Shared JWT secret — generate with: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=<run: openssl rand -hex 32>

# =============================================================================
# Frontend
# =============================================================================

# Internal URL of the frontend container — used by the backend to resolve
# hashed JS/CSS bundle names for share link pages. Default is correct for
# docker-compose. Override only if the frontend runs on a different host.
# FRONTEND_URL=http://frontend:80
