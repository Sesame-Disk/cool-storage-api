# =============================================================================
# SesameFS — Nginx Production Config (Template)
# =============================================================================
# This file is processed by the nginx Docker image on startup.
# - ${DOMAIN}        → substituted from DOMAIN env var
# - ${OFFICE_DOMAIN} → substituted from OFFICE_DOMAIN env var
# - $${nginx_var}    → becomes $nginx_var after substitution (nginx syntax)
# =============================================================================

# Rate limiting zone (http context — applies to all server blocks below)
limit_req_zone $${binary_remote_addr} zone=api:10m rate=100r/s;

# Mobile User-Agent detection — single authoritative location (Go no longer duplicates this)
map $${http_user_agent} $${is_mobile} {
    default 0;
    ~*(?:Android|iPhone|iPad|iPod|Mobile|Opera\ Mini|IEMobile|WPDesktop) 1;
}

# Upstream definitions
upstream sesamefs_api {
    server sesamefs:8080;
}

upstream sesamefs_frontend {
    server frontend:80;
}

upstream sesamefs_mobile {
    server mobile-frontend:80;
}

# =============================================================================
# HTTP → HTTPS redirect (both domains)
# =============================================================================
server {
    listen 80;
    server_name ${DOMAIN} ${OFFICE_DOMAIN};

    # Allow Let's Encrypt ACME renewal (certbot --webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$${host}$${request_uri};
    }
}

# =============================================================================
# Main App — SesameFS API + Frontend
# =============================================================================
server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    # SSL — cert covers both ${DOMAIN} and ${OFFICE_DOMAIN}
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy no-referrer-when-downgrade;

    # Large file uploads (sesamefs supports up to 20 GB)
    client_max_body_size 20G;

    # Block Prometheus metrics from external access
    location /metrics {
        deny all;
        return 403;
    }

    # API routes → Go backend
    # - api/api2/seafhttp: core API and file transfer
    # - accounts/oauth/client-login/client-sso: auth flows (logout, OIDC, desktop client)
    # - d/u: share links and upload links
    # - lib/repo: file viewer and raw file serving
    # - onlyoffice/office-convert: document editing
    # - smart-link/billing/share: misc backend-rendered routes
    location ~ ^/(api|api2|seafhttp|seafile|ping|health|ready|accounts|oauth|client-login|client-sso|d|u|lib|repo|onlyoffice|office-convert|smart-link|billing|share|saml2|org/custom)(/|$) {
        limit_req zone=api burst=200 nodelay;

        proxy_pass http://sesamefs_api;
        proxy_http_version 1.1;

        proxy_set_header Host              $${host};
        proxy_set_header X-Real-IP         $${remote_addr};
        proxy_set_header X-Forwarded-For   $${proxy_add_x_forwarded_for};
        proxy_set_header X-Forwarded-Proto $${scheme};

        proxy_request_buffering off;
        proxy_buffering         off;

        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_connect_timeout 30s;
    }

    # Everything else → frontend container (React SPA) or mobile-frontend
    # Mobile UA routing lives here and only here.
    location / {
        limit_req zone=api burst=200 nodelay;

        set $${frontend_upstream} http://sesamefs_frontend;
        if ($${is_mobile}) {
            set $${frontend_upstream} http://sesamefs_mobile;
        }

        proxy_pass $${frontend_upstream};
        proxy_http_version 1.1;

        proxy_set_header Host              $${host};
        proxy_set_header X-Real-IP         $${remote_addr};
        proxy_set_header X-Forwarded-For   $${proxy_add_x_forwarded_for};
        proxy_set_header X-Forwarded-Proto $${scheme};

        # No request/response buffering needed for static SPA assets
        proxy_buffering         off;
        proxy_connect_timeout   10s;
        proxy_read_timeout      60s;
    }
}

# =============================================================================
# OnlyOffice Document Server
# =============================================================================
server {
    listen 443 ssl http2;
    server_name ${OFFICE_DOMAIN};

    # Same SSL cert (must include ${OFFICE_DOMAIN} as SAN)
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-Content-Type-Options nosniff;

    client_max_body_size 500M;

    location / {
        proxy_pass http://onlyoffice:80;
        proxy_http_version 1.1;

        # WebSocket support (required for real-time co-editing)
        proxy_set_header Upgrade    $${http_upgrade};
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $${host};
        proxy_set_header X-Real-IP         $${remote_addr};
        proxy_set_header X-Forwarded-For   $${proxy_add_x_forwarded_for};
        proxy_set_header X-Forwarded-Proto $${scheme};

        proxy_buffering    off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
